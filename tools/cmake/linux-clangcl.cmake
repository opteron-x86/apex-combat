set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
find_program(CMAKE_C_COMPILER NAMES clang-cl clang-cl-20 clang-cl-19 REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES clang-cl clang-cl-20 clang-cl-19 REQUIRED)
find_program(CMAKE_LINKER NAMES lld-link lld-link-20 lld-link-19 REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES llvm-rc llvm-rc-20 llvm-rc-19 REQUIRED)
find_program(CMAKE_MT NAMES llvm-mt llvm-mt-20 llvm-mt-19 REQUIRED)
if(NOT DEFINED XWIN_SYSROOT)
    set(XWIN_SYSROOT "$ENV{XWIN_SYSROOT}" CACHE PATH "Windows SDK/CRT winsysroot")
endif()
if(NOT IS_DIRECTORY "${XWIN_SYSROOT}")
    message(FATAL_ERROR "Set XWIN_SYSROOT to an xwin winsysroot-style SDK/CRT directory.")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES XWIN_SYSROOT)
set(_target_flags "--target=x86_64-pc-windows-msvc /winsysroot\"${XWIN_SYSROOT}\"")
set(CMAKE_C_FLAGS_INIT "${_target_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_target_flags} /EHsc")
set(CMAKE_RC_FLAGS_INIT "${_target_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/winsysroot:\"${XWIN_SYSROOT}\"")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "/winsysroot:\"${XWIN_SYSROOT}\"")
